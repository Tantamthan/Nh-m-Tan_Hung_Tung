@page
@{
    ViewData["Title"] = "Reset Password Confirmation";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="eyebrow">Password Updated</span>
            <h1>Đặt lại mật khẩu thành công</h1>
            <p>Bạn có thể đăng nhập lại bằng mật khẩu mới.</p>
        </div>

        <div class="auth-links centered">
            <a asp-page="./Login">Đăng nhập ngay</a>
        </div>
    </div>
</section>
