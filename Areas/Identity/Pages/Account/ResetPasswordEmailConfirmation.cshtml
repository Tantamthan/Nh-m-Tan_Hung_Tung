@page
@{
    ViewData["Title"] = "Reset Password Email Confirmation";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="eyebrow">Email Sent</span>
            <h1>Đã gửi email reset password</h1>
            <p>
                Hệ thống đã gửi link reset password đến email của bạn.
                Vui lòng kiểm tra inbox hoặc spam để tiếp tục.
            </p>
        </div>

        <div class="auth-links centered">
            <a asp-area="ServiceRequests" asp-controller="Dashboard" asp-action="Dashboard">Về Dashboard</a>
        </div>
    </div>
</section>
