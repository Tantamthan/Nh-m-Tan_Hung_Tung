@page
@model Lab8_PhamVanTung_2324801030079.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="eyebrow">Password Recovery</span>
            <h1>Quên mật khẩu</h1>
            <p>Nhập email đăng ký. Hệ thống sẽ gửi link đặt lại mật khẩu nếu tài khoản hợp lệ.</p>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>

            <div class="auth-links">
                <a asp-page="./Login">Quay lại đăng nhập</a>
            </div>
        </form>
    </div>
</section>
