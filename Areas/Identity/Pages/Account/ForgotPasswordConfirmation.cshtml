@page
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="eyebrow">Email Confirmation</span>
            <h1>Yêu cầu đã được ghi nhận</h1>
            <p>
                Nếu email tồn tại trong hệ thống, chúng tôi đã gửi link đặt lại mật khẩu.
                Vui lòng kiểm tra hộp thư và thư mục spam.
            </p>
        </div>

        <div class="auth-links centered">
            <a asp-page="./Login">Quay lại đăng nhập</a>
        </div>
    </div>
</section>
