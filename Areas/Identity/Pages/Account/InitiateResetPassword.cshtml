@page
@model Lab8_PhamVanTung_2324801030079.Areas.Identity.Pages.Account.InitiateResetPasswordModel
@{
    ViewData["Title"] = "Initiate Reset Password";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="eyebrow">Authenticated Reset</span>
            <h1>Yêu cầu gửi link reset password</h1>
            <p>Email hiện tại: <strong>@Model.CurrentEmail</strong></p>
        </div>

        <form method="post" class="auth-form">
            <button type="submit" class="btn btn-primary w-100">Gửi link reset qua email</button>
        </form>
    </div>
</section>
