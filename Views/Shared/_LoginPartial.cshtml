@using Lab8_PhamVanTung_2324801030079.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-lg-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="btn btn-outline-primary btn-sm" asp-area="ServiceRequests" asp-controller="Dashboard" asp-action="Dashboard">
                Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a href="#" class="btn btn-outline-secondary btn-sm" data-submit-form="public-reset-password-form">
                Reset Password
            </a>
        </li>
        <li class="nav-item">
            <a href="#" class="btn btn-primary btn-sm" data-submit-form="public-logout-form">
                Logout
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

@if (SignInManager.IsSignedIn(User))
{
    <form id="public-logout-form" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        @Html.AntiForgeryToken()
    </form>

    <form id="public-reset-password-form" method="post" asp-area="Identity" asp-page="/Account/InitiateResetPassword">
        @Html.AntiForgeryToken()
    </form>
}
