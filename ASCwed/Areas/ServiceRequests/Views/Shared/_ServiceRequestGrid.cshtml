@model IEnumerable<ASC.Model.Models.ServiceRequest>
@using ASC.Model.BaseTypes
@{
    var isAudit = ViewBag.IsAudit == true;
    var tableId = ViewBag.Id as string ?? "tblServiceRequests";
    var sectionName = ViewBag.SectionName as string ?? "Service Requests";
}

<div class="row"></div>
<div class="row padding-top-20px">
    <div class="col s12 z-depth-3">
        <div class="section white-text padding-left-10px blue-grey lighten-1">
            <h5>@sectionName</h5>
        </div>
        <div class="divider"></div>
        <div class="col s12 padding-bottom-15px">
            @* Danh sách yêu cầu dịch vụ theo quyền hiện tại *@
            <table class="highlight centered responsive-table tblServiceRequests" id="@tableId">
                <thead>
                    <tr>
                        <th data-field="RowKey">RowKey</th>
                        <th data-field="PartitionKey">PartitionKey</th>
                        <th data-field="PartitionKey">User</th>
                        <th data-field="Status">Status</th>
                        <th data-field="RequestedDate">Requested Date</th>
                        <th data-field="ServiceEngineer">Service Engineer</th>
                        @if (isAudit)
                        {
                            <th data-field="RequestedServices">Requested Services</th>
                        }
                        <th data-field="Actions">View</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var serviceRequest in Model)
                    {
                        <tr>
                            <td>@serviceRequest.RowKey</td>
                            <td>@serviceRequest.PartitionKey</td>
                            <td>
                                @(serviceRequest.PartitionKey.Contains('-')
                                    ? serviceRequest.PartitionKey.Split(new[] { '-' })[0]
                                    : serviceRequest.PartitionKey)
                            </td>
                            <td>
                                @{
                                    var parsed = Enum.TryParse<Status>(serviceRequest.Status, out var serviceStatus);
                                }
                                @if (parsed)
                                {
                                    switch (serviceStatus)
                                    {
                                        case Status.New:
                                        case Status.Initiated:
                                        case Status.InProgress:
                                        case Status.Completed:
                                            <div class="white-text teal lighten-1 center-align">
                                                <span>@serviceRequest.Status</span>
                                            </div>
                                            break;
                                        case Status.RequestForInformation:
                                        case Status.Pending:
                                        case Status.Denied:
                                            <div class="white-text red lighten-1 center-align">
                                                <span>@serviceRequest.Status</span>
                                            </div>
                                            break;
                                        case Status.PendingCustomerApproval:
                                            <div class="white-text orange lighten-1 center-align">
                                                <span>@serviceRequest.Status</span>
                                            </div>
                                            break;
                                        default:
                                            <span>@serviceRequest.Status</span>
                                            break;
                                    }
                                }
                                else
                                {
                                    <span>@serviceRequest.Status</span>
                                }
                            </td>
                            <td>
                                @(serviceRequest.RequestedDate == null
                                    ? string.Empty
                                    : serviceRequest.RequestedDate.Value.ToString("dd/MM/yyyy"))
                            </td>
                            <td>@serviceRequest.ServiceEngineer</td>
                            @if (isAudit)
                            {
                                var trimText = string.IsNullOrWhiteSpace(serviceRequest.RequestedServices)
                                    ? string.Empty
                                    : serviceRequest.RequestedServices.Length > 50
                                        ? string.Format("{0}...", serviceRequest.RequestedServices.Substring(0, 50))
                                        : serviceRequest.RequestedServices;
                                <td title="@serviceRequest.RequestedServices">@trimText</td>
                            }
                            <td>
                                <a asp-area="ServiceRequests"
                                   asp-controller="ServiceRequest"
                                   asp-action="Details"
                                   asp-route-partitionKey="@serviceRequest.PartitionKey"
                                   asp-route-rowKey="@serviceRequest.RowKey"
                                   aria-label="View service request details">
                                    <i class="small material-icons view cursor-hand">pageview</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
